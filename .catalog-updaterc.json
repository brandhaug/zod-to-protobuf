{
	"branchPrefix": "catalog-update",
	"defaultBranch": "master",
	"maxOpenPrs": 20,
	"concurrency": 10,
	"groups": [
		{
			"name": "oxc",
			"patterns": ["oxlint", "oxlint-*", "@oxlint/*", "oxfmt"]
		},
		{ "name": "all-patch-updates", "patterns": ["*"], "updateTypes": ["patch"] }
	],
	"ignore": [],
	"minReleaseAgeDays": 3,
	"autoMerge": { "enabled": true, "mergeMethod": "squash" }
}
